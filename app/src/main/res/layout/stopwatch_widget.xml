<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <Chronometer
        android:id="@+id/stopwatch_widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:textColor="@color/widget_text"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/stopwatch_widget_laps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/stopwatch_widget_reset"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/sw_reset_button"
            android:src="@drawable/ic_widget_reset" />

        <ImageButton
            android:id="@+id/stopwatch_widget_toggle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/widget_button_primary"
            android:tint="@color/widget_on_button_primary"
            tools:ignore="UseAppTint"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/stopwatch_widget_lap"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/sw_lap_button"
            android:src="@drawable/ic_widget_lap" />
    </LinearLayout>
</LinearLayout>
