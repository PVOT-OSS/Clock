<resources xmlns:tools="http://schemas.android.com/tools"
    xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2"
    tools:ignore="MissingTranslation">
    <plurals name="bedtime_sleep_hours">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> hr</item>
        <item quantity="other"><xliff:g id="count" example="9">%d</xliff:g> hr</item>
    </plurals>
    <plurals name="bedtime_sleep_minutes">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> min</item>
        <item quantity="other"><xliff:g id="count" example="45">%d</xliff:g> mins</item>
    </plurals>
    <string name="bedtime_sleep_length"><xliff:g id="hours" example="9 hr">%1$s</xliff:g>, <xliff:g id="minutes" example="45 mins">%2$s</xliff:g></string>
    <string name="bedtime_dial_later">Later</string>
    <string name="bedtime_dial_earlier">Earlier</string>
    <string name="bedtime_goal_title">Sleep goal</string>
    <string name="bedtime_goal_below">Below your sleep goal (~<xliff:g id="goal" example="8 hr">%s</xliff:g>)</string>
    <string name="bedtime_goal_meets">Meets your sleep goal (~<xliff:g id="goal" example="8 hr">%s</xliff:g>)</string>
    <string name="bedtime_goal_above">Above your sleep goal (~<xliff:g id="goal" example="8 hr">%s</xliff:g>)</string>
    <plurals name="bedtime_reminder_short">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> min before</item>
        <item quantity="other"><xliff:g id="count" example="15">%d</xliff:g> min before</item>
    </plurals>
</resources>
