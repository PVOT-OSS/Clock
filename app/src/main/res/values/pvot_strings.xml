<resources xmlns:tools="http://schemas.android.com/tools"
    xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2"
    tools:ignore="MissingTranslation">
    <!-- Snackbar shown when the app may not show alarms full screen -->
    <string name="full_screen_alarms_blocked">Alarms can\'t open full screen</string>
    <!-- Snackbar shown when the app may not schedule exact alarms -->
    <string name="exact_alarms_blocked">Alarms may go off late</string>
    <!-- Snackbar shown when battery settings restrict the app in the background -->
    <string name="background_restricted">Battery settings may delay alarms</string>
    <!-- Snackbar shown when the alarm volume is set very low -->
    <string name="alarm_volume_low">Alarm volume is low</string>
    <!-- Action on the low alarm volume snackbar -->
    <string name="increase_alarm_volume">Increase</string>
    <!-- Row in an expanded one-time alarm that picks the date it rings on -->
    <string name="alarm_schedule_date">Schedule alarm</string>
    <!-- Row in an expanded repeating alarm that pauses it for a range of dates -->
    <string name="alarm_pause">Pause alarm</string>
    <!-- Summary of a paused repeating alarm; args are the first and last paused dates -->
    <string name="alarm_paused_range">Paused <xliff:g id="start" example="21 Nov">%1$s</xliff:g> – <xliff:g id="end" example="25 Nov">%2$s</xliff:g></string>
    <!-- Title of the date picker for a one-time alarm -->
    <string name="alarm_schedule_date_title">Ring on</string>
    <!-- Title of the date range picker that pauses a repeating alarm -->
    <string name="alarm_pause_title">Pause alarm on these dates</string>
    <!-- Picker button that removes the date from a one-time alarm -->
    <string name="alarm_date_remove">Remove date</string>
    <!-- Picker button that ends a pause of a repeating alarm -->
    <string name="alarm_pause_resume">Resume</string>
    <!-- Setting: how a ringing alarm is snoozed or stopped -->
    <string name="dismiss_gesture_title">Snooze and stop gesture</string>
    <string-array name="dismiss_gesture_entries">
        <item>Swipe</item>
        <item>Tap</item>
    </string-array>
    <string-array name="dismiss_gesture_values" translatable="false">
        <item>swipe</item>
        <item>tap</item>
    </string-array>
    <!-- Spoken with a collapsed alarm that has no sound but vibrates -->
    <string name="alarm_badge_vibrate_only">Vibrate only</string>
    <!-- Spoken with a collapsed alarm that has no sound and does not vibrate -->
    <string name="alarm_badge_silent">Silent</string>
    <!-- Sound picker row that opens a recorder app to record a new alarm sound -->
    <string name="record_new_sound">Record new sound</string>
    <!-- Title of a recorded alarm sound; arg is when it was recorded -->
    <string name="recorded_sound_title">Recording <xliff:g id="when" example="13 Nov 2026 2:45 am">%s</xliff:g></string>
</resources>
